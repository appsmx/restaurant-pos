# ==========================================
# POS Restaurante — Variables de Entorno
# ==========================================
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas tu .env al repositorio.

# ---- Base de datos (PostgreSQL / Neon) ----
DATABASE_URL="postgresql://usuario:contraseña@host/database?sslmode=require"

# ---- Autenticación (JWT) ----
# Usa un string largo y aleatorio. Ejemplo: openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-seguro"

# ---- Servidor ----
PORT=3001

# ---- Frontend URL (para CORS en producción) ----
FRONTEND_URL="https://tu-app.vercel.app"
